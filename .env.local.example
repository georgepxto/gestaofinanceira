# Exemplo de variáveis de ambiente
# Copie este arquivo para .env.local e preenchça com suas credenciais do Supabase

# URL do seu projeto Supabase
# Encontre em: Supabase Dashboard → Settings → API → Project URL
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima do Supabase (seguro expor ao cliente)
# Encontre em: Supabase Dashboard → Settings → API → anon public
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# Client ID OAuth do Google (opcional — habilita login Google sem redirect,
# via Google Identity Services + signInWithIdToken; o popup mostra o nome do
# app em vez de "to continue to …supabase.co")
# Use o MESMO client ID configurado no provider Google do Supabase.
# Encontre em: Google Cloud Console → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
